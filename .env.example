# Groq API Configuration (Optional: leaving unset runs CallCraft AI in offline mode)
GROQ_API_KEY=
# Verified Groq model identifiers (e.g., llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL=
GROQ_JUDGE_MODEL=

# Execution Settings
CALLCRAFT_TEMPERATURE=0.0
CALLCRAFT_MAX_TOKENS=400
CALLCRAFT_TIMEOUT_SECONDS=30
CALLCRAFT_MAX_RETRIES=2

# Storage & Upload Settings
CALLCRAFT_DB_PATH=.callcraft/callcraft.db
CALLCRAFT_MAX_UPLOAD_MB=5
